### Required variables ###
NEXT_PUBLIC_INFURA_TOKEN=10bbca828bfb4bf19326b7e42c8fbf6d
NEXT_PUBLIC_GATEWAY_URL_PRODUCTION=http://localhost:8000/cgw

# infura token used by Safe Apps
NEXT_PUBLIC_SAFE_APPS_INFURA_TOKEN=10bbca828bfb4bf19326b7e42c8fbf6d

# Transaction simulation
NEXT_PUBLIC_TENDERLY_SIMULATE_ENDPOINT_URL=
NEXT_PUBLIC_TENDERLY_PROJECT_NAME=
NEXT_PUBLIC_TENDERLY_ORG_NAME=

# Flag to switch to the production environment (redirect urls, gateway url, etc)
NEXT_PUBLIC_IS_PRODUCTION=false

### Optional variables ###
# These variables are required only if you require a certain feature in the interface (e.g. Portis wallet)
# Or overwrite the fallback values (set a different WalletConnect bridge)

# Latest supported safe version, used for upgrade prompts
NEXT_PUBLIC_SAFE_VERSION=1.4.1

# Access keys
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_BEAMER_ID=

# Wallet specific variables
NEXT_PUBLIC_WC_BRIDGE=
NEXT_PUBLIC_FORTMATIC_KEY=
NEXT_PUBLIC_PORTIS_KEY=
NEXT_PUBLIC_CYPRESS_MNEMONIC=

NEXT_PUBLIC_DEFAULT_MAINNET_CHAIN_ID=190415
NEXT_PUBLIC_DEFAULT_TESTNET_CHAIN_ID=181228
NEXT_PUBLIC_GATEWAY_URL_STAGING=http://localhost:8000/cgw

# apps/web/.env.local

# 🚩 Transaction Service (거래/서명 등)
NEXT_PUBLIC_SAFE_APPS_TRANSACTION_SERVICE_URL=http://localhost:8000/txs/api/v1/

# 🚩 Web 환경용 추가 변수
NEXT_PUBLIC_ENVIRONMENT=local
NEXT_PUBLIC_NETWORK=custom
# 예: 1337 (Hardhat) 또는 42161 (Arbitrum)
NEXT_PUBLIC_CHAIN_ID=181228
# 실제 RPC 주소
NEXT_PUBLIC_RPC_URL=https://sepolia.hpp.io
# 🚩 Gateway API (프론트엔드가 붙을 주 API)
NEXT_PUBLIC_SAFE_APPS_GATEWAY_URL=http://localhost:8000/cgw
# 🚩 Config Service (네트워크 정보 및 컨트랙트 정보)
NEXT_PUBLIC_SAFE_APPS_CONFIG_SERVICE_URL=http://localhost:8000/cfg/api/v1/
